# ============================================================
# Invite Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Discord Application ─────────────────────────────────────
# Create your app at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# OAuth2 redirect URI — must be added in the Discord Developer
# Portal under OAuth2 > Redirects.
# Development:
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
# Production (replace with your actual domain):
# DISCORD_REDIRECT_URI=https://your-app.railway.app/api/auth/discord/callback

# ── Session ─────────────────────────────────────────────────
# Any long random string — generate with: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_random_secret

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string.
# Free options: Neon (neon.tech), Supabase, Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# When dashboard and API share the same origin (recommended),
# you can leave this blank.
DASHBOARD_URL=

# ── Server ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Optional: separate frontend ─────────────────────────────
# Only needed if you deploy the dashboard on a DIFFERENT domain
# from the API. Set this in the dashboard's build environment.
# VITE_API_URL=https://your-api.railway.app
