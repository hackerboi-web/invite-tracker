{
  "name": "invite-tracker-bot",
  "version": "1.0.0",
  "description": "Discord invite tracker bot with public API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "lint": "eslint src --ext .ts",
    "db:push": "tsx src/database/push-schema.ts"
  },
  "dependencies": {
    "discord.js": "^14.15.3",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}